# ─────────────────────────────────────────────────────────────────────
# RepairAI Pro — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────

# ── Firebase (client) ────────────────────────────────────────────────
# Firebase Console → Project Settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin SDK ───────────────────────────────────────────────
# Firebase Console → Project Settings → Service accounts → Generate private key
# Paste the ENTIRE downloaded JSON as a single-line string (use jq -c . key.json)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ── Stripe ───────────────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_
STRIPE_PUBLISHABLE_KEY=pk_live_
# dashboard.stripe.com → Developers → Webhooks → Add endpoint
# URL: https://yourdomain.com/api/stripe/webhook
# Events: payment_intent.succeeded, customer.subscription.created/updated/deleted, account.updated
STRIPE_WEBHOOK_SECRET=whsec_

# ── OpenAI ───────────────────────────────────────────────────────────
# platform.openai.com/api-keys
OPENAI_API_KEY=sk-

# ── Resend (transactional email) ─────────────────────────────────────
# resend.com → API Keys  |  resend.com/domains (verify your domain first)
RESEND_API_KEY=re_
RESEND_FROM=noreply@repairai.pro

# ── Meta / Instagram (social auto-post) ──────────────────────────────
# developers.facebook.com → My Apps → create app → add Instagram product
# Callback URL: https://yourdomain.com/api/social/instagram/callback
# Permissions needed: instagram_basic, instagram_content_publish
META_APP_ID=
META_APP_SECRET=

# ── TikTok (social auto-post) ────────────────────────────────────────
# developers.tiktok.com → Manage apps → create app
# Callback URL: https://yourdomain.com/api/social/tiktok/callback
# Scopes: user.info.basic, video.publish, video.upload
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Twilio (SMS — optional, gracefully degraded if blank) ────────────
# console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1

# ── Cloudinary (chat image uploads) ──────────────────────────────────
# cloudinary.com → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── App URLs ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://repairai.pro
NEXT_PUBLIC_BASE_URL=https://repairai.pro

# ── Admin access ─────────────────────────────────────────────────────
# Your Firebase UID: Firebase Console → Authentication → Users → copy UID
# Comma-separated for multiple admins
ADMIN_UIDS=
NEXT_PUBLIC_ADMIN_UIDS=

# ── Cron (win-back email + stale jobs) ───────────────────────────────
# Any random string. Vercel sends it automatically via vercel.json cron.
CRON_SECRET=

# ── Google Places (contractor profile import) ─────────────────────────
# console.cloud.google.com → APIs → Places API → Credentials
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# ── Agora (video consultations — optional) ────────────────────────────
# console.agora.io
# NEXT_PUBLIC_AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=

# ── Wisetack / Affirm (financing — coming soon) ───────────────────────
# Add when you sign up with a lending partner
# WISETACK_API_KEY=
# WISETACK_MERCHANT_ID=
