rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ================= HELPERS ================= */

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function job(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId));
    }

    function isJobOwner(jobId) {
      return signedIn() && job(jobId).data.userId == uid();
    }

    function isClaimedContractor(jobId) {
      return signedIn()
        && job(jobId).data.claimedBy != null
        && job(jobId).data.claimedBy == uid();
    }

    function isParticipant(jobId) {
      return isJobOwner(jobId) || isClaimedContractor(jobId);
    }

    function onlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    /* ================= USERS ================= */

    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    /* ================= CONTRACTORS ================= */

    match /contractors/{contractorId} {

      allow read: if signedIn();

      allow create: if signedIn() && uid() == contractorId;

      allow update: if signedIn()
        && uid() == contractorId
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly([
            "name",
            "email",
            "phone",
            "trade",
            "trades",
            "city",
            "zipCode",
            "serviceZones",
            "serviceRadiusMiles",
            "availability",
            "availabilityBlocks",
            "availabilityUpdatedAt",
            "workingHours",
            "bufferMinutes",
            "defaultJobDurationMinutes",
            "autoAcceptBookings",
            "bio",
            "photoURL",
            "website",
            "rating",
            "reviewCount",
            "reputationScore",
            "jobsCompleted",
            "jobsAccepted",
            "responseCount",
            "invitationAcceptCount",
            "invitationDeclineCount",
            "boostActive",
            "boostLevel",
            "certifications",
            "images",
            "lastActiveAt",
            "updatedAt",
            "createdAt"
          ])
        // boostActive must be boolean
        && (
          !("boostActive" in request.resource.data)
          || request.resource.data.boostActive is bool
        )
        // boostLevel must be 1–3
        && (
          !("boostLevel" in request.resource.data)
          || (
            request.resource.data.boostLevel is int
            && request.resource.data.boostLevel >= 1
            && request.resource.data.boostLevel <= 3
          )
        );

      allow delete: if false;

      /* contractor job inbox — readable/writable only by the contractor */
      match /jobInbox/{inboxId} {
        allow read: if signedIn() && uid() == contractorId;
        allow write: if false; // written by API routes only
      }

      /* ================= SPECIALIZATIONS ================= */
      match /specializations/{specId} {
        // All signed-in users can read contractor specializations
        allow read: if signedIn();
        // Written by API routes (admin SDK) only
        allow write: if false;
      }

      /* ================= QUALITY SCORE ================= */
      match /qualityScore/{scoreId} {
        // All signed-in users can read quality scores
        allow read: if signedIn();
        // Written by API routes (admin SDK) only
        allow write: if false;
      }
    }

    /* ================= BUSINESSES ================= */

    match /businesses/{businessId} {
      allow read: if signedIn();

      // Businesses are seeded via Google Places import (admin SDK).
      // A signed-in owner can claim and update their own listing.
      allow create: if signedIn();

      allow update: if signedIn()
        && (
          // Owner editing their claimed listing
          resource.data.ownerId == uid()
          ||
          // First-time claim: ownerId not yet set
          (!("ownerId" in resource.data) && request.resource.data.ownerId == uid())
        );

      allow delete: if false;
    }

    /* ================= JOBS ================= */

    match /jobs/{jobId} {

      /* ---------- READ ---------- */
      // Signed-in users can read jobs (contractors need to browse open jobs)
      allow read: if signedIn();

      /* ---------- CREATE ---------- */
      // Normally written by the create-job API route (admin SDK, bypasses rules).
      // This rule covers any direct client writes.
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.claimedBy == null
        && request.resource.data.status in ["triaged", "open", "matched"]
        && onlyKeys([
          "userId",
          "description",
          "location",
          "trade",
          "claimedBy",
          "status",
          "aiSummary",
          "aiDetectedTrade",
          "aiSeverity",
          "createdAt",
          "updatedAt"
        ]);

      /* ---------- UPDATE ---------- */
      allow update: if signedIn() && (

        /* OWNER — safe field edits only */
        (
          uid() == resource.data.userId &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              "description",
              "location",
              "trade",
              "aiSummary",
              "aiDetectedTrade",
              "aiSeverity",
              "updatedAt"
            ])
        )

        ||

        /* CONTRACTOR ACCEPTS JOB (triaged / matched → accepted) */
        (
          resource.data.claimedBy == null &&
          resource.data.status in ["triaged", "matched", "open"] &&
          request.resource.data.claimedBy == uid() &&
          request.resource.data.status == "accepted"
        )

        ||

        /* CONTRACTOR STARTS JOB (accepted → in_progress) */
        (
          resource.data.status == "accepted" &&
          request.resource.data.status == "in_progress" &&
          resource.data.claimedBy == uid()
        )

        ||

        /* CONTRACTOR MARKS COMPLETE (in_progress → completed) */
        (
          resource.data.status == "in_progress" &&
          request.resource.data.status == "completed" &&
          resource.data.claimedBy == uid()
        )

        ||

        /* OWNER CONFIRMS COMPLETION (completed → confirmed) */
        (
          resource.data.status == "completed" &&
          request.resource.data.status == "confirmed" &&
          uid() == resource.data.userId
        )

        ||

        /* CONTRACTOR UPDATES LOCATION (real-time tracking) */
        (
          resource.data.claimedBy == uid() &&
          resource.data.status in ["accepted", "in_progress"] &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              "contractorLocation",
              "lastLocationUpdate"
            ])
        )
      );

      allow delete: if false;

      /* ================= MESSAGES ================= */

      match /messages/{messageId} {
        allow read: if isParticipant(jobId);

        allow create: if isParticipant(jobId)
          && request.resource.data.senderId == uid()
          && onlyKeys(["text", "senderId", "createdAt", "type", "imageUrl"])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;

        allow update, delete: if false;
      }

      /* ================= ATTACHMENTS ================= */

      match /attachments/{attId} {
        allow read: if isParticipant(jobId);
        allow create: if isParticipant(jobId);
        allow update, delete: if false;
      }

      /* ================= APPOINTMENTS ================= */

      match /appointments/{appointmentId} {
        allow read: if isParticipant(jobId);

        allow create: if isParticipant(jobId)
          && request.resource.data.createdBy == uid()
          && request.resource.data.status == "proposed"
          && request.resource.data.startAt is timestamp
          && request.resource.data.endAt is timestamp
          && request.resource.data.endAt > request.resource.data.startAt
          && onlyKeys([
            "startAt",
            "endAt",
            "timezone",
            "status",
            "createdBy",
            "createdAt"
          ]);

        allow update: if isParticipant(jobId)
          && request.resource.data.startAt == resource.data.startAt
          && request.resource.data.endAt == resource.data.endAt
          && request.resource.data.createdBy == resource.data.createdBy
          && (
            (
              resource.data.status == "proposed" &&
              request.resource.data.status in ["accepted", "declined"] &&
              uid() != resource.data.createdBy
            )
            ||
            (
              resource.data.status == "accepted" &&
              request.resource.data.status == "cancelled"
            )
          );

        allow delete: if false;
      }

      /* ================= REVIEWS ================= */

      match /reviews/{reviewId} {
        allow read: if isParticipant(jobId);

        // Only after owner confirms completion
        allow create: if isJobOwner(jobId)
          && job(jobId).data.status == "confirmed"
          && request.resource.data.reviewerId == uid()
          && request.resource.data.contractorId == job(jobId).data.claimedBy
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && onlyKeys([
            "reviewerId",
            "contractorId",
            "rating",
            "comment",
            "createdAt"
          ]);

        allow update, delete: if false;
      }

      /* ================= EVENTS ================= */

      match /events/{eventId} {
        allow read: if isParticipant(jobId);

        allow create: if isParticipant(jobId)
          && request.resource.data.actorId == uid()
          && request.resource.data.type is string
          && request.resource.data.type.size() > 0
          && request.resource.data.type.size() <= 80
          && (
            !("message" in request.resource.data)
            || (
              request.resource.data.message is string
              && request.resource.data.message.size() <= 500
            )
          )
          && (
            !("meta" in request.resource.data)
            || request.resource.data.meta is map
          )
          && onlyKeys(["type", "message", "actorId", "meta", "createdAt"]);

        allow update, delete: if false;
      }

      /* ================= CONTRACTOR LOCATION (Real-time tracking) ================= */
      // Update: Allow contractors to update their location on the job document
      // Also allow location history tracking in subcollection

      match /locationHistory/{historyId} {
        // WRITE: Only the claiming contractor can log location history
        allow create: if signedIn()
          && job(jobId).data.claimedBy == uid()
          && job(jobId).data.status in ["accepted", "in_progress"]
          && request.resource.data.contractorId == uid()
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.timestamp is number
          && onlyKeys(["contractorId", "lat", "lng", "timestamp", "accuracy", "speed", "heading", "distanceMiles", "durationMinutes", "avgSpeed"]);

        // READ: Homeowner can read location history during active job
        allow read: if signedIn()
          && uid() == job(jobId).data.userId
          && job(jobId).data.claimedBy != null
          && job(jobId).data.status in ["accepted", "in_progress"];

        // Contractor can read their own history
        allow read: if signedIn()
          && job(jobId).data.claimedBy == uid()
          && job(jobId).data.status in ["accepted", "in_progress"];

        // DELETE: Not allowed
        allow delete: if false;
      }

      /* ================= NOTIFICATION HISTORY ================= */
      match /notificationHistory/{notificationId} {
        // WRITE: Only API can write (server-side via Cloud Function)
        allow write: if false;

        // READ: Job participants can read
        allow read: if isParticipant(jobId);

        // DELETE: Not allowed
        allow delete: if false;
      }

      /* ================= INVITATIONS ================= */

      match /invitations/{invitationId} {
        // Contractors can read their own invitations
        allow read: if signedIn();
        // Written by API routes (admin SDK) only
        allow write: if false;
      }

      /* ================= WORK PHOTOS (Evidence) ================= */
      match /workPhotos/{photoId} {
        // Contractor uploads photos during job
        allow create: if signedIn()
          && job(jobId).data.claimedBy == uid()
          && job(jobId).data.status in ["accepted", "in_progress"]
          && request.resource.data.uploadedBy == uid()
          && request.resource.data.url is string
          && request.resource.data.stage is string
          && onlyKeys([
            "url",
            "uploadedBy",
            "uploadedAt",
            "caption",
            "stage",
            "verified",
            "aiCategory",
            "thumbnailUrl",
            "metadata"
          ]);

        // Homeowner can read photos after job completion
        allow read: if signedIn()
          && uid() == job(jobId).data.userId
          && job(jobId).data.status in ["completed", "confirmed"];

        // Contractor can read their own photos
        allow read: if signedIn()
          && request.auth.uid == resource.data.uploadedBy;

        allow update, delete: if false;
      }

      /* ================= PROGRESS UPDATES ================= */
      match /progressUpdates/{updateId} {
        // Contractor logs progress during job
        allow create: if signedIn()
          && job(jobId).data.claimedBy == uid()
          && job(jobId).data.status in ["accepted", "in_progress"]
          && onlyKeys([
            "contractorId",
            "timestamp",
            "status",
            "currentTask",
            "elapsedMinutes",
            "estimatedMinutesRemaining",
            "location",
            "photoIds",
            "notes"
          ]);

        // Homeowner can read progress during job
        allow read: if signedIn()
          && uid() == job(jobId).data.userId
          && job(jobId).data.status in ["accepted", "in_progress"];

        allow update, delete: if false;
      }

      /* ================= DISPUTES ================= */
      match /disputes/{disputeId} {
        // Homeowner can file dispute after job completion
        allow create: if isJobOwner(jobId)
          && job(jobId).data.status in ["completed", "confirmed"]
          && request.resource.data.filedBy == uid()
          && request.resource.data.status == "open"
          && onlyKeys([
            "filedBy",
            "description",
            "evidencePhotoIds",
            "status",
            "createdAt"
          ]);

        // Participants can read disputes
        allow read: if isParticipant(jobId);

        allow update, delete: if false;
      }

      /* ================= PHOTO ANALYSES (AI Analysis Results) ================= */
      match /photoAnalyses/{analysisId} {
        // Homeowner can create analyses for their jobs
        allow create: if isJobOwner(jobId)
          && job(jobId).data.status in ["triaged", "matched", "open"]
          && request.resource.data.analysedAt is timestamp
          && onlyKeys([
            "photoUrls",
            "trade",
            "description",
            "severity",
            "defects",
            "detectedObjects",
            "summary",
            "requiresVideoConsultation",
            "report",
            "analysedAt",
            "analysisCount"
          ]);

        // Participants can read analyses
        allow read: if isParticipant(jobId);

        allow update, delete: if false;
      }

      /* ================= PRODUCT RECOMMENDATIONS ================= */
      match /productRecommendations/{recId} {
        // Participants can read recommendations
        allow read: if isParticipant(jobId);
        // Written by API routes (admin SDK) only
        allow write: if false;
      }

      /* ================= PRODUCT EVENTS (Tracking clicks/views) ================= */
      match /productEvents/{eventId} {
        // Job participants can create product events
        allow create: if isParticipant(jobId)
          && request.resource.data.userId == uid()
          && request.resource.data.timestamp is timestamp
          && request.resource.data.eventType in ["clicked", "viewed", "purchased"]
          && onlyKeys([
            "productId",
            "source",
            "eventType",
            "userId",
            "userType",
            "timestamp"
          ]);

        // Participants can read product events
        allow read: if isParticipant(jobId);

        allow update, delete: if false;
      }

      /* ================= COMPLETION PHOTOS (Final work photos) ================= */
      match /completionPhotos/{photoId} {
        // Contractor uploads final photos during job
        allow create: if signedIn()
          && job(jobId).data.claimedBy == uid()
          && job(jobId).data.status in ["in_progress", "completed"]
          && request.resource.data.uploadedBy == uid()
          && request.resource.data.url is string
          && request.resource.data.uploadedAt is timestamp
          && onlyKeys([
            "url",
            "thumbnailUrl",
            "uploadedBy",
            "uploadedAt",
            "cloudinaryPublicId",
            "metadata"
          ]);

        // Homeowner can read completion photos after upload
        allow read: if signedIn()
          && (
            uid() == job(jobId).data.userId
            || uid() == job(jobId).data.claimedBy
          );

        allow update, delete: if false;
      }

      /* ================= COMPLETIONS (Before/after photo pairs) ================= */
      match /completions/{completionId} {
        // Written by API routes only
        allow write: if false;
        // Participants can read
        allow read: if isParticipant(jobId);
      }

      /* ================= INVOICES ================= */
      match /invoices/{invoiceId} {
        // Written by API routes only (uses admin SDK)
        allow write: if false;
        // Both homeowner and contractor can read
        allow read: if isParticipant(jobId);
      }

      /* ================= MILESTONES ================= */
      match /milestones/{milestoneId} {
        // Both participants can read milestones
        allow read: if isParticipant(jobId);

        // Homeowner can create milestones when setting up the job
        allow create: if isJobOwner(jobId)
          && job(jobId).data.status in ["triaged", "open", "matched", "accepted"]
          && onlyKeys([
            "title",
            "description",
            "percentage",
            "amount",
            "dueDate",
            "status",
            "order",
            "createdAt",
            "updatedAt"
          ]);

        // Homeowner approves/releases milestone; contractor marks ready_for_release
        allow update: if isParticipant(jobId)
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["status", "approvedAt", "releasedAt", "updatedAt"]);

        allow delete: if false;
      }

      /* ================= VIDEO CONSULTATIONS ================= */
      match /videoConsultations/{consultId} {
        // Both participants can read consultations
        allow read: if isParticipant(jobId);

        // Contractor requests a consultation
        allow create: if signedIn()
          && job(jobId).data.claimedBy == uid()
          && request.resource.data.contractorId == uid()
          && request.resource.data.status == "requested"
          && onlyKeys([
            "contractorId",
            "homeownerId",
            "status",
            "proposedTimes",
            "notes",
            "requestedAt",
            "createdAt"
          ]);

        // Either participant can update (approve/decline/complete via API)
        // Client-side updates are limited to safe status transitions
        allow update: if isParticipant(jobId)
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              "status",
              "scheduledAt",
              "approvedAt",
              "declinedAt",
              "completedAt",
              "agoraToken",
              "updatedAt"
            ]);

        allow delete: if false;
      }
    }

    /* ================= NOTIFICATIONS (in-app bell) ================= */
    // Path: notifications/{userId}/items/{itemId}
    // Written by server (admin SDK via createNotification). Each user reads
    // and marks-read only their own notifications.
    match /notifications/{userId}/items/{itemId} {
      allow read: if signedIn() && uid() == userId;

      // Client may only flip the `read` flag (mark-as-read) — nothing else.
      allow update: if signedIn()
        && uid() == userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["read"]);

      // Created server-side only; users may delete their own notifications.
      allow create: if false;
      allow delete: if signedIn() && uid() == userId;
    }

    /* ================= WORK POSTS (social feed) ================= */

    match /posts/{postId} {
      // Public read — work feed is visible to everyone
      allow read: if true;

      // Contractors create their own posts
      allow create: if signedIn()
        && request.resource.data.contractorId == uid()
        && request.resource.data.keys().hasAll(["contractorId", "caption", "trade", "createdAt"]);

      // Server-side increments (likeCount, commentCount, viewCount) only
      allow update: if false;
      allow delete: if signedIn() && resource.data.contractorId == uid();

      /* Likes — toggle per viewer */
      match /likes/{viewerId} {
        allow read: if true;
        allow write: if signedIn() && uid() == viewerId;
      }

      /* Comments — public read, auth create */
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 600;
        // Server handles replyCount increments
        allow update: if false;
        allow delete: if signedIn() && resource.data.authorId == uid();
      }
    }

    /* ================= SOCIAL GRAPH ================= */

    // contractors/{id}/followers/{viewerUid}
    match /contractors/{contractorId}/followers/{viewerUid} {
      allow read: if true;
      allow write: if signedIn() && uid() == viewerUid;
    }

    // users/{id}/following/{contractorId}
    match /users/{userId}/following/{contractorId} {
      allow read: if signedIn() && uid() == userId;
      allow write: if signedIn() && uid() == userId;
    }

    /* ================= CONTRACTOR REVIEWS (public) ================= */
    match /contractors/{contractorId}/reviews/{reviewId} {
      allow read: if true;
      // Written by API routes only (verified token in server)
      allow write: if false;
    }

    /* ================= HOMEOWNERS ================= */
    match /homeowners/{userId} {
      allow read:   if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId;
      allow update: if signedIn() && uid() == userId;
      allow delete: if false;
    }

    /* ================= ANALYTICS EVENTS (funnel tracking) ================= */
    match /analyticsEvents/{eventId} {
      // Written server-side only; admins read via API
      allow read, write: if false;
    }

    /* ================= HOMEOWNER MAINTENANCE ================= */
    match /homeMaintenancePlans/{planId} {
      allow read:  if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update: if signedIn() && resource.data.userId == uid();
      allow delete: if signedIn() && resource.data.userId == uid();
    }

    /* ================= REFERRALS ================= */
    match /referrals/{referralId} {
      allow read: if signedIn()
        && (resource.data.referrerId == uid() || resource.data.referredId == uid());
      allow write: if false; // server only
    }

    /* ================= DEFAULT DENY ================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
