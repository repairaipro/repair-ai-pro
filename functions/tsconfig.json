{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "outDir": "lib",
    "sourceMap": false,
    "strict": true,
    "target": "es2017",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declaration": false,
    "types": []
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
